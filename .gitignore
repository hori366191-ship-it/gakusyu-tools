# git bundle のバックアップファイル(Drive 同期フォルダへ移動後の残骸対策)
backup-*.bundle

# clasp の認証トークン(ホームディレクトリにあるが誤混入防止のため)
.clasprc.json

# Wrangler のローカルキャッシュ
site-worker/.wrangler/
site-worker/.dev.vars
# 教室タブレット用の実デプロイ設定（実オリジン/D1 ID 等を含む・.example のみ追跡）
site-worker/wrangler.classroom.toml
site-worker/wrangler.classroom-maintenance.toml
site-worker/wrangler.classroom-auth.toml
# 教室 Pages（build-classroom-pages.mjs の生成物）
site-worker/.pages-classroom/

# app11 の開発時だけ使う NetworkX 環境（再現手順は scripts/app11/planarity/requirements.txt）
.venv-app11/

# Windows のデスクトップ設定
desktop.ini

# 機密情報ロードマップ（ローカル専用・コミットしない）
ロードマップ_機密情報.md

# 旧GAS避難（GitHub未追跡・Driveへは backup.ps1 でコピー）
archive/
# clasp scriptId（機密列挙防止・個別管理）
**/.clasp.json

# Pages staging output (scripts/app11/build-pages-staging.cjs)
_pages/

# Python のキャッシュ（scripts/app11/planarity の実行時生成物）
__pycache__/
*.pyc
